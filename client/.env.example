# =============================================================================
# Manish Yadav Portfolio — Client Environment Variables
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file → rename to .env.local (Vite uses .env.local for secrets)
#   2. NEVER commit .env.local to version control
# =============================================================================

# ---------------------------------------------------------------------------
# Backend API URL
# ---------------------------------------------------------------------------
# LOCAL DEV  → Leave EMPTY or comment out.
#              Vite's dev proxy (vite.config.js) forwards "/api/*" requests to
#              http://localhost:5000, so you never hit CORS issues locally.
#
# PRODUCTION → Set this on Vercel's Environment Variables dashboard to
#              your deployed Render backend URL (including the /api path):
#              Example: https://manish-portfolio-api.onrender.com/api
#
VITE_API_URL=
