# =============================================================================
# Manish Yadav Portfolio — Server Environment Variables
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file → rename to .env
#   2. Fill in ALL values below (no variable may be left blank)
#   3. NEVER commit .env to version control
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB Atlas ---
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster.mongodb.net/manish_portfolio

# --- Google Gemini AI ---
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Resend Email API ---
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_KEY_HERE

# --- CORS & Client ---
# During local dev, both point to the Vite dev server
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
